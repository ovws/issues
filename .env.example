# Copy to .env. Never commit real secrets.
INTERNAL_AI_HOST=0.0.0.0
INTERNAL_AI_DB_DIR=./data
INTERNAL_AI_LOG_DIR=./logs
INTERNAL_AI_MEDIA_DIR=./data/media
INTERNAL_AI_QUEUE_CAPACITY=100
INTERNAL_AI_MAX_REQUEST_BYTES=33554432
INTERNAL_AI_TEXT_TIMEOUT_SECONDS=300
INTERNAL_AI_IMAGE_TIMEOUT_SECONDS=900
INTERNAL_AI_EDIT_TIMEOUT_SECONDS=1200
INTERNAL_AI_VIDEO_TIMEOUT_SECONDS=3600
INTERNAL_AI_STATUS_TIMEOUT_SECONDS=60
INTERNAL_AI_RETENTION_DAYS=7

# Public gateways. Upstreams stay loopback-only.
GROK_PORT=8001
GROK_UPSTREAM_URL=http://127.0.0.1:18001
GROK_UPSTREAM_API_KEY=replace-with-grok-client-key

GEMINI_PORT=8002
GEMINI_COOKIE_FILE=./config/gemini-cookies.local.json
GEMINI_PROXY_URL=
GEMINI_DEFAULT_MODEL=gemini-3-flash
GEMINI_VIDEO_MODEL=gemini-3-pro
GEMINI_REFRESH_INTERVAL_SECONDS=600

CHATGPT_IMAGE_PORT=8003
CHATGPT_IMAGE_UPSTREAM_URL=http://127.0.0.1:18003
CHATGPT_IMAGE_UPSTREAM_API_KEY=replace-with-chatgpt2api-auth-key
CHATGPT_IMAGE_PUBLIC_BASE_URL=http://192.168.x.x:8003
CHATGPT_IMAGE_FAILURE_THRESHOLD=3
